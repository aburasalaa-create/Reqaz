# API server — secrets live only here (or in the host's secret manager), never in the web app.
NODE_ENV=production
PORT=8787
DATABASE_URL=postgres://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
APP_ORIGIN=https://app.reqaz.com
AUTH_MODE=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Only for legacy HS256 projects; projects with asymmetric JWT keys use the JWKS endpoint automatically.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_DRIVER=supabase
STORAGE_BUCKET=rms-documents
MAX_UPLOAD_MB=25
