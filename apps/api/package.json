{
  "name": "@rms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --alias:@rms/shared=../../packages/shared/src/index.ts --outfile=dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "8.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@rms/shared": "0.1.0",
    "@types/qrcode": "1.5.5",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "playwright-core": "1.63.0",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
